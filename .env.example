# Supabase Configuration
# Use the SAME project as the partyup-mobile app (see its .env for the values)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Mapbox Configuration
# Get your token from: https://account.mapbox.com/tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Analytics Configuration (optional)
# Umami endpoint and website ID for analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Demo login hint (optional — only set these on a demo/preview deployment)
# Shows a "demo access" box on the login page with staff/admin credentials for reviewers
VITE_SHOW_DEMO_LOGIN=false
VITE_DEMO_STAFF_EMAIL=
VITE_DEMO_STAFF_PASSWORD=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
